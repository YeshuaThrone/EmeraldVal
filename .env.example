# Covnant signup (POST /api/covnant/auth/signup) talks to Supabase Auth
# for password hashing / email verification, then inserts creator_profiles.
# Copy to .env.local. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
